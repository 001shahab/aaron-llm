#
# Keeps the history single authored, whatever is driving git.
#
# An attribution trailer is stripped rather than refused, because editors and agents
# append one automatically and a refusal there would only block the commit without
# removing the trailer. Anything a human had to type deliberately, a wrong identity or
# a tool credit written into prose, is refused so it gets fixed at the source.
#
# Enable it once per clone:
#
#     git config core.hooksPath .githooks
#
set -eu

MESSAGE_FILE="$1"
EXPECTED_NAME="Prof. Shahab Anbarjafari"
EXPECTED_EMAIL="shb@3sholding.com"
TRAILERS='^[[:space:]]*(co-authored-by|signed-off-by|assisted-by|reviewed-by|helped-by|generated-by|created-by)[[:space:]]*:'
FAILED=0

fail() {
	printf 'commit refused: %s\n' "$1" >&2
	FAILED=1
}

# Identity. Author and committer must both be the sole author.
for role in AUTHOR COMMITTER; do
	name=$(eval "printf '%s' \"\${GIT_${role}_NAME:-}\"")
	email=$(eval "printf '%s' \"\${GIT_${role}_EMAIL:-}\"")
	[ -n "$name" ] || name=$(git config user.name || true)
	[ -n "$email" ] || email=$(git config user.email || true)

	if [ "$name" != "$EXPECTED_NAME" ] || [ "$email" != "$EXPECTED_EMAIL" ]; then
		fail "$(printf '%s is %s <%s>, expected %s <%s>' \
			"$role" "$name" "$email" "$EXPECTED_NAME" "$EXPECTED_EMAIL")"
	fi
done

# Attribution trailers: strip them, then drop the blank lines they leave behind.
if grep -Eiq "$TRAILERS" "$MESSAGE_FILE"; then
	stripped="${MESSAGE_FILE}.solo"
	grep -Eiv "$TRAILERS" "$MESSAGE_FILE" >"$stripped" || true
	awk '{ line[NR] = $0 }
	     END {
	         last = NR
	         while (last > 0 && line[last] ~ /^[[:space:]]*$/) last--
	         for (i = 1; i <= last; i++) print line[i]
	     }' "$stripped" >"$MESSAGE_FILE"
	rm -f "$stripped"
	printf 'note: removed an attribution trailer. This repository has one author.\n' >&2
fi

# Tool credits written as prose. Attribution phrasing only: a model named as the
# subject of a change, "fix the gpt-4o cost calculation", is ordinary content here.
if grep -Eiq 'generated (with|by)|co-?(written|created|developed) (with|by)|(written|created|authored|produced|implemented|assisted) (with|by) +(an? +)?(ai|llm|assistant|agent|claude|copilot|chatgpt|cursor|gemini|codex)' \
	"$MESSAGE_FILE"; then
	fail "the message credits a tool. Describe what changed and why, not what wrote it."
fi

if [ "$FAILED" -ne 0 ]; then
	printf '\nSee .cursor/rules/solo-authorship.mdc for the rule this enforces.\n' >&2
	exit 1
fi
